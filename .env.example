# Copy to .env.local for local development. Set the same keys in the Vercel project.
# Never commit real credentials to this file.

# SMTP used by /api/demo to send demo-request emails.
# Provision a clinax.in mailbox (e.g. via Spaceship) and add SPF/DKIM/DMARC DNS
# records for clinax.in before going live, otherwise mail will land in spam.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Sender identity and internal inbox for demo requests (both required).
FROM_EMAIL=
TO_EMAIL=

# Public contact address rendered in the footer / CTA.
NEXT_PUBLIC_CONTACT_EMAIL=Clinax@truespur.ai

# Canonical domain override (optional). Default is https://clinax.in.
# Set this to https://www.clinax.in only as a temporary rollback if the site
# must deploy before the apex domain is attached in Vercel.
#NEXT_PUBLIC_SITE_URL=https://clinax.in

# Search engine ownership verification (optional). Paste the token only, not
# the full <meta> tag. Rendered as <meta name="google-site-verification"> /
# <meta name="msvalidate.01"> in the root layout.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
